[node name="conv0" type="Node" parent="Conversations"]
script = ExtResource("5_helrn")
player_choice = "Klaus! What can I get you?"
patron_response = "Something spicy and bright, if you please. Need my energy tonight."
memories_unlocked = Array[ExtResource("6_055tp")]([SubResource("Resource_a0jqs")])
