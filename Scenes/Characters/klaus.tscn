[node name="conv1" type="Node" parent="Conversations"]
script = ExtResource("5_helrn")
player_choice = "Ah, that's a shame. I was hoping you'd get to try the Halfling Whiskey you delivered yesterday. It's marvelous."
patron_response = "No thanks. Spicy and bright for me."
memories_required = Array[ExtResource("6_055tp")]([SubResource("Resource_4cy8d")])
memories_unlocked = Array[ExtResource("6_055tp")]([SubResource("Resource_t8aw7")])
startDay = 1

[node name="conv2" type="Node" parent="Conversations"]
script = ExtResource("5_helrn")
player_choice = "It's been some time since you've sat and had a drink. How are you?"
patron_response = "Alright, I guess. The winery has been a bit slow. Can't seem to make a name for myself."
memories_required = Array[ExtResource("6_055tp")]([SubResource("Resource_3k61i")])
memories_unlocked = Array[ExtResource("6_055tp")]([SubResource("Resource_khkj1")])
startDay = 1

[node name="conv3" type="Node" parent="Conversations"]
script = ExtResource("5_helrn")
player_choice = "I'm sure business will pick up."
patron_response = "At least I've still got your business to rely on, eh? Not like you've ever realy had a slow day."
memories_required = Array[ExtResource("6_055tp")]([SubResource("Resource_nijbj")])
memories_unlocked = Array[ExtResource("6_055tp")]([SubResource("Resource_h04xf")])
startDay = 1

[node name="conv4" type="Node" parent="Conversations"]
script = ExtResource("5_helrn")
player_choice = "I am lucky. Let me know if you need anything else."
patron_response = "Thanks."
memories_required = Array[ExtResource("6_055tp")]([SubResource("Resource_aa5sc")])
